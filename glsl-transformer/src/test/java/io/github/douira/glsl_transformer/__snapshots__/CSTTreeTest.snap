	vec4 v1;
	vec4 v2;
} c;
.
.
in vec4 P;

vec4 getColor2()
{
	return a.color2;
}

vec4 getWorld()
{
	return b.uWorld * P;
	c.v2 = vec4(1);
}
.
.
