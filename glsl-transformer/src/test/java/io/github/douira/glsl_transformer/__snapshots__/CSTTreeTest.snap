#extension GL_EXT_buffer_reference : enable

layout(set = 1, binding = 2, buffer_reference, std430) buffer t4 {
    layout(offset = 0)  int j;
};

layout(std430) buffer t5 {
    t4 m;
} s5;

t4 f1(const t4 y) { return y; }
t4 f2(t4 y) { return y; }
