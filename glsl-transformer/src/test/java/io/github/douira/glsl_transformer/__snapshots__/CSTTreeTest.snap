#version 450

#extension GL_NVX_multiview_per_view_attributes :require

layout(vertices = 4) out;
out gl_PerVertex {
    int gl_ViewportMaskPerViewNV[];
    vec4 gl_PositionPerViewNV[];
 } gl_out[];
