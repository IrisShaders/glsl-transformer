{
    vec4  f4;
    ivec4 i4;
    uvec4 u4;
    dvec4 d4;
} data[4];

void main()
{
    uint invocation = (gl_SubgroupInvocationID + gl_SubgroupSize) % 4;

    data[invocation].f4.x   = subgroupAdd(data[0].f4.x);
    data[invocation].f4.xy  = subgroupAdd(data[1].f4.xy);
