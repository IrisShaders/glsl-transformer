    data[invocation].u8.x   = subgroupQuadSwapHorizontal(data[0].u8.x);
    data[invocation].u8.xy  = subgroupQuadSwapHorizontal(data[1].u8.xy);
    data[invocation].u8.xyz = subgroupQuadSwapHorizontal(data[2].u8.xyz);
