	sampler3D[4](t3d5, sA[2]);
	sampler2D(i2d, s);
	sampler2D(t3d[1], s);
	sampler2D(t2d, sShadow);
	sampler2DShadow(t2d, s);
}
sampler2D s2D = sampler2D(t2d, s);
sampler3D s3d[4] = sampler3D[4](t3d, sA[2]);
out vec4 color;
void main() {
	color = texture(s2D, vec2(0.5f));
	color += texture(s3d[i], vec3(0.5f));
}
