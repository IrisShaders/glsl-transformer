§testExpressions calls:
#version 460
int i; uint u; float f; double d; bool b; vec2 v2; vec3 v; ivec3 iv; mat3 m; float a[3]; struct S { int a; } s;
void none() {}
float one(float x) { return x; }
int over(int x) { return x; }
float over(float x) { return x; }
vec3 over(vec3 x) { return x; }
bool over(int x, int y) { return true; }
float prefer(float x) { return x; }
double prefer(double x) { return x; }
int amb(uint x, float y) { return 1; }
int amb(float x, uint y) { return 1; }
float ambDiff(uint x, float y) { return 1.0; }
int ambDiff(float x, uint y) { return 1; }
void outParam(out float x) { x = 1.0; }
void inoutParam(inout float x) { x = 1.0; }
void outInt(out int x) { x = 1; }
void arrayParam(float x[3]) {}
void structParam(S x) {}
float notAFunction;
