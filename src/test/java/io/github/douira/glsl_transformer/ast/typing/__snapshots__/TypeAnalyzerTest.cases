none() => void
none(void) => void
one(1.0) => float
one(1) => float
one(u) => float
over(1) => int
over(1.0) => float
over(v) => vec3
over(iv) => vec3
over(1, 2) => bool
over(u) => float
prefer(f) => float
prefer(d) => double
prefer(i) => float
prefer(u) => float
arrayParam(a) => void
structParam(s) => void
structParam(S(1)) => void
none(1) => <error> ! NO_MATCHING_OVERLOAD
one() => <error> ! NO_MATCHING_OVERLOAD
one(1.0, 2.0) => <error> ! NO_MATCHING_OVERLOAD
one(d) => <error> ! NO_MATCHING_OVERLOAD
one(b) => <error> ! NO_MATCHING_OVERLOAD
one(v) => <error> ! NO_MATCHING_OVERLOAD
over(b) => <error> ! NO_MATCHING_OVERLOAD
over(1, 2, 3) => <error> ! NO_MATCHING_OVERLOAD
arrayParam(f) => <error> ! NO_MATCHING_OVERLOAD
structParam(1) => <error> ! NO_MATCHING_OVERLOAD
